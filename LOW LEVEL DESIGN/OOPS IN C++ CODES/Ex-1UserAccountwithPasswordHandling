#include <iostream>
#include <string>
#include <stdexcept>

// Mock LoginResult class for demonstration -> Encapsulation least usage of getter and setter but the public methods are used to access the private members of the class.
class LoginResult {
    bool isSuccess;
    std::string userId;
    int remainingAttempts;
    bool isLocked;

    LoginResult(bool success, std::string id, int remaining, bool locked)
        : isSuccess(success), userId(std::move(id)), remainingAttempts(remaining), isLocked(locked) {}

public:
    static LoginResult success(std::string userId) {
        return LoginResult(true, std::move(userId), 0, false);
    }
    static LoginResult invalidCredentials(int remaining) {
        return LoginResult(false, "", remaining, false);
    }
    static LoginResult accountLocked() {
        return LoginResult(false, "", 0, true);
    }

    void printStatus() const {
        if (isSuccess) {
            std::cout << "Login successful! Welcome, User ID: " << userId << "\n";
        } else if (isLocked) {
            std::cout << "Login failed: Account is locked.\n";
        } else {
            std::cout << "Login failed: Invalid credentials. Attempts remaining: " << remainingAttempts << "\n";
        }
    }
};

// Mock PasswordHasher class for demonstration
class PasswordHasher {
public:
    static std::string hash(const std::string& rawPassword) {
        return "hashed_" + rawPassword; // Simple mock hash logic
    }
    static bool verify(const std::string& rawPassword, const std::string& storedHash) {
        return hash(rawPassword) == storedHash;
    }
};

class UserAccount {
    const std::string userId;
    std::string email;
    std::string passwordHash;
    int failedLoginAttempts = 0;
    bool locked = false;

public:
    UserAccount(std::string userId, std::string email, const std::string& rawPassword)
        : userId(std::move(userId)), email(std::move(email)), passwordHash(PasswordHasher::hash(rawPassword)) {}

    LoginResult authenticate(const std::string& rawPassword) {
        if (locked) return LoginResult::accountLocked();

        if (!PasswordHasher::verify(rawPassword, passwordHash)) {
            if (++failedLoginAttempts >= 5) locked = true;
            return LoginResult::invalidCredentials(5 - failedLoginAttempts);
        }

        failedLoginAttempts = 0;
        return LoginResult::success(userId);
    }

    void changeEmail(const std::string& newEmail, const std::string& currentPassword) {
        if (!PasswordHasher::verify(currentPassword, passwordHash)) {
            throw std::runtime_error("Password required to change email");
        }
        email = newEmail;
    }

    std::string getEmail() const { return email; }
};

int main() {
    // 1. Create a new account
    UserAccount account("usr_101", "user@example.com", "SecretPass123");
    std::cout << "Created account for: " << account.getEmail() << "\n\n";

    // 2. Test failed login attempts
    std::cout << "--- Testing Failed Logins ---\n";
    for (int i = 0; i < 3; ++i) {
        LoginResult result = account.authenticate("WrongPassword");
        result.printStatus();
    }

    // 3. Test successful login (resets failed attempt counter)
    std::cout << "\n--- Testing Successful Login ---\n";
    LoginResult successResult = account.authenticate("SecretPass123");
    successResult.printStatus();

    // 4. Test changing email with correct password
    std::cout << "\n--- Testing Email Change ---\n";
    try {
        account.changeEmail("new_email@example.com", "SecretPass123");
        std::cout << "Email updated successfully to: " << account.getEmail() << "\n";
    } catch (const std::exception& e) {
        std::cout << "Error: " << e.what() << "\n";
    }

    // 5. Test changing email with wrong password
    try {
        account.changeEmail("invalid_update@example.com", "WrongPassword");
    } catch (const std::exception& e) {
        std::cout << "Failed to change email: " << e.what() << "\n";
    }

    // 6. Test locking account after 5 consecutive failures
    std::cout << "\n--- Testing Account Lockout ---\n";
    for (int i = 0; i < 6; ++i) {
        LoginResult result = account.authenticate("BadPassword");
        result.printStatus();
    }

    return 0;
}